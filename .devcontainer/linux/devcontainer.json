{
    "name": "OCCL Net Plugin - Linux Release",
    "build": {
        "dockerfile": "../Dockerfile.linux",
        "target": "vscode-dev",
        "options": [
            "--platform=linux/amd64",
            "--pull=true"
        ],
        "args": {
            "TARGET_ARCH_CACHE": "linux-amd64"
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest"
        }
    },
    "mounts": [
        "source=occl-net-ccache-vol,target=/root/.cache/ccache,type=volume",
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly"
    ],
    "containerEnv": {
        "OCCL_NET_HOST_WORKSPACE": "${localWorkspaceFolder}",
        "OCCL_NET_RELEASE_BUILDER_IMAGE_TEMPLATE": "occl-net-linux-release-builder:%ARCH%"
    },
    "postCreateCommand": "git config --global --add safe.directory '*'",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "timonwong.shellcheck",
                "xaver.clang-format"
            ],
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.arguments": [
                    "--background-index",
                    "--compile-commands-dir=${workspaceFolder}/build/linux-release",
                    "--clang-tidy",
                    "--header-insertion=iwyu",
                    "--completion-style=detailed"
                ],
                "editor.formatOnSave": true,
                "[c]": {
                    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
                },
                "cmake.generator": "Ninja",
                "cmake.configureOnOpen": false,
                "cmake.buildDirectory": "${workspaceFolder}/build/linux-release",
                "cmake.configureArgs": [
                    "-C${workspaceFolder}/cmake/occl-net-ib-release-cache.cmake",
                    "-DCMAKE_C_COMPILER_LAUNCHER=ccache",
                    "-DCMAKE_CXX_COMPILER_LAUNCHER=ccache"
                ]
            }
        }
    },
    "remoteUser": "root"
}
